{
  "cli": {
    "version": ">= 16.15.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "admin",
        "API_BASE_URL": "http://0.0.0.0:8000/api/",
        "RESET_URL": "http://0.0.0.0:8000/reset-password"
      }
    },
    "development-client": {
      "extends": "development",
      "env": { "APP_VARIANT": "client" }
    },
    "preview-admin": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "admin",
        "API_BASE_URL": "https://timelyonestaging.pythonanywhere.com/api/",
        "RESET_URL": "https://timelyonestaging.pythonanywhere.com/reset-password"
      }
    },
    "preview-client": {
      "extends": "preview-admin",
      "env": { "APP_VARIANT": "client" }
    },
    "production-admin": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "admin",
        "API_BASE_URL": "https://salonix-backend-production.up.railway.app/api/",
        "RESET_URL": "https://salonix-backend-production.up.railway.app/reset-password"
      }
    },
    "production-client": {
      "extends": "production-admin",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "client" }
    }
  },
  "submit": {
    "production-admin": {},
    "production-client": {}
  }
}
